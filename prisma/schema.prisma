generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}
enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}
model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  project   Project      @relation(fields: [projectId], references: [id])
  projectId String
  issues    Issue[]
  createdAt DateTime     @default(now())
}
model User {
  id          String          @id @default(cuid())
  name        String
  email       String          @unique
  password    String
  projects    Project[]       @relation("ProjectOwner")
  issues      Issue[]         @relation("IssueAssignee")
  memberships ProjectMember[]
  comments Comment[]
  activities Activity[]
  createdAt   DateTime        @default(now())
}
model Comment {
  id        String   @id @default(cuid())
  content   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  issueId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
}
model ProjectMember {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}
model Project {
  id        String      @id @default(cuid())
  name      String
  key       String      @unique
  type      ProjectType @default(KANBAN)
  owner     User        @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId   String
  issues    Issue[]
  sprints Sprint[]
  members   ProjectMember[]
  createdAt DateTime    @default(now())
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}
enum ProjectType {
  KANBAN
  SCRUM
}
enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  dueDate     DateTime?
  number Int @default(0)
  storyPoints Int?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id])
  sprintId    String?
  project     Project       @relation(fields: [projectId], references: [id])
  projectId   String
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  order       Int           @default(0)
  comments    Comment[]
  activities  Activity[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  type      String   // CREATED | STATUS_CHANGED | PRIORITY_CHANGED | ASSIGNEE_CHANGED
  fromValue String?
  toValue   String?
  issue     Issue    @relation(fields: [issueId], references: [id])
  issueId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}